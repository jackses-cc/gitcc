# 环境变量模板
#
# 用法：
#   1. 复制一份为 .env：  Copy-Item .env.example .env
#   2. 在 .env 里填入真实值
#
# 注意：.env 已被 .gitignore 忽略，不会提交到仓库；
#       本文件（.env.example）只放占位符，可以安全提交。

# --- 示例：API 密钥 ---
# API_KEY=your_api_key_here

# --- 示例：数据库连接 ---
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# --- 示例：调试开关 ---
# DEBUG=true
